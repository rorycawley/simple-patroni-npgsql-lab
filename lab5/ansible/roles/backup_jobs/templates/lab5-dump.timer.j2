[Unit]
Description=Take an encrypted logical dump of the application database

[Timer]
# A slower cycle than pgBackRest on purpose: the dump's job is surgical recovery
# and verification, not recency. pgBackRest is what bounds data loss.
OnBootSec={{ lab5_dump_on_boot }}
OnUnitActiveSec={{ lab5_dump_interval }}
Unit=lab5-dump.service
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
