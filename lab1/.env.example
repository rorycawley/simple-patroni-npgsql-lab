# Generated values after `make create_vms`.
# PG*_IP holds the Lima shared-network address of each VM. The Npgsql client and
# the Ansible dynamic inventory both read those, so they are required; the
# PG*_HOST names only resolve after `make configure_hostnames`.
PGPORT=5432
PG1_HOST=pg1.lab.example
PG1_IP=192.168.105.11
PG2_HOST=pg2.lab.example
PG2_IP=192.168.105.12
PG3_HOST=pg3.lab.example
PG3_IP=192.168.105.13
PGHOSTS=pg1.lab.example:5432,pg2.lab.example:5432,pg3.lab.example:5432
