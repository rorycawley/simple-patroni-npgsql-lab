# Patroni's distributed configuration. patroni.yml.j2 includes this file for the
# one-time bootstrap.dcs block, and playbooks/bootstrap.yml applies it to the
# running cluster with `patronictl edit-config`, so both paths stay identical.
#
# Patroni requires ttl >= loop_wait + 2 * retry_timeout. These values sit exactly
# on that floor (30 = 10 + 2 * 10), so raising loop_wait or retry_timeout without
# also raising ttl makes Patroni reject the configuration.
ttl: 30
loop_wait: 10
retry_timeout: 10
primary_start_timeout: 0
maximum_lag_on_failover: 1048576
check_timeline: true

# Quorum commit: a transaction is not acknowledged to the client until at least
# synchronous_node_count standbys have flushed it, so a failover cannot lose an
# acknowledged transaction. Patroni maintains synchronous_standby_names as
# "ANY 1 (pg1, pg2, pg3)" minus the leader, and tracks the eligible set in the
# DCS /sync key so only a node known to be caught up can be promoted.
#
# node_count 1 of 2 available standbys is the deliberate trade: one standby may
# fail without blocking writes.
#
# synchronous_mode_strict makes the durability guarantee unconditional. Without
# it, Patroni CLEARS synchronous_standby_names when no standby can confirm and
# the primary carries on asynchronously -- silently, with the client never told
# that its durability guarantee has weakened. Strict mode refuses to clear it, so
# a commit blocks in SyncRep rather than completing on a single node.
#
# The accepted cost is a real outage: with every standby unavailable, writes stop
# until one returns. Two conditions follow and are not optional -- clients need a
# command timeout, because a blocked commit hangs rather than failing fast (the
# lab client sets Command Timeout=10), and rolling maintenance must never take
# both standbys out at once. One can always be lost freely; the second stops
# writes.
#
# Losing two of three nodes entirely is read-only either way, because etcd
# quorum goes with them. The setting only changes the narrower case where the
# standby databases are down while their nodes are up.
synchronous_mode: quorum
synchronous_node_count: 1
synchronous_mode_strict: true
postgresql:
  use_pg_rewind: true
  use_slots: true
  parameters:
    wal_level: replica
    hot_standby: "on"
    max_wal_senders: 10
    max_replication_slots: 10
    wal_log_hints: "on"
    # Explicit because quorum commit depends on it: synchronous_standby_names has
    # no effect unless commits wait for a remote flush. "local" or "off" here
    # would silently turn the cluster back into asynchronous replication.
    synchronous_commit: "on"
    password_encryption: scram-sha-256
    ssl: "off"
    archive_mode: "on"
    archive_timeout: 60s
    archive_command: pgbackrest --stanza={{ lab1_cluster_name }} archive-push %p
  pg_hba:
    - local all all peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host replication replicator 127.0.0.1/32 scram-sha-256
{% for host in groups['patroni_nodes'] %}
    - host replication replicator {{ hostvars[host].lab1_node_ip }}/32 scram-sha-256
    - host postgres postgres {{ hostvars[host].lab1_node_ip }}/32 scram-sha-256
{% endfor %}
    - host appdb app_runtime {{ lab1_host_gateway_ip }}/32 scram-sha-256
