[Unit]
Description=Patroni-managed Percona PostgreSQL HA node
After=network-online.target etcd.service
Wants=network-online.target
# Refuse to start without the data volume. Without this, a failed mount would
# leave Patroni to initialise an empty data directory over the mountpoint and
# report a healthy cluster holding none of the data.
RequiresMountsFor={{ lab3_postgres_data_dir }}

[Service]
Type=simple
# Second layer: RequiresMountsFor above catches a mount that fails, but not one
# that was never configured. This refuses to start on the root filesystem.
ExecStartPre=/usr/local/sbin/lab3-require-volume /var/lib/pgsql /dev/mapper/lab3-pgdata
User=postgres
Group=postgres
ExecStart=/usr/bin/patroni /etc/patroni/patroni.yml
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=process
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
