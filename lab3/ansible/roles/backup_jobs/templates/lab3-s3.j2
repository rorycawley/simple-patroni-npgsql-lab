#!/usr/bin/env python3
"""Minimal S3 client for the dump job: put, list and delete, signed with SigV4.

Why this exists rather than curl --aws-sigv4:

    Rocky 9 ships curl 7.76.1, the first release that has the flag at all, and
    its signatures are rejected by MinIO with SignatureDoesNotMatch -- on GET
    and PUT alike. Measured, after the flag's presence was mistaken for the
    feature working.

Why not mc or awscli: both mean fetching a binary or enabling another repo at
build time, for three HTTP verbs. The standard library already has HMAC-SHA256
and an HTTPS client that accepts a private CA, which is the whole requirement.

Only what the dump job needs, and nothing else: no multipart, no retries, no
credential discovery. pgBackRest does its own S3 and is unaffected by any of it.
"""
import datetime
import hashlib
import hmac
import ssl
import sys
import urllib.parse
import urllib.request

ENDPOINT = "https://{{ lab3_repo_endpoint }}:{{ lab3_repo_port }}"
BUCKET = "{{ lab3_repo_bucket }}"
REGION = "{{ lab3_repo_region }}"
CA_FILE = "{{ lab3_pki_dir }}/ca.crt"
ACCESS_KEY = "{{ minio_backup_access_key }}"
SECRET_KEY = "{{ minio_backup_secret_key }}"
SERVICE = "s3"
EMPTY_SHA256 = hashlib.sha256(b"").hexdigest()


def _sign(key: bytes, msg: str) -> bytes:
    return hmac.new(key, msg.encode(), hashlib.sha256).digest()


def _request(method: str, key: str, query: str = "", body: bytes = b"") -> bytes:
    host = urllib.parse.urlsplit(ENDPOINT).netloc
    # Path style: the bucket is part of the path, not the hostname. MinIO has no
    # DNS entry per bucket, which is the same reason pgBackRest is configured
    # with repo1-s3-uri-style=path.
    canonical_uri = "/" + BUCKET + ("/" + key if key else "")
    canonical_uri = urllib.parse.quote(canonical_uri, safe="/~")

    now = datetime.datetime.now(datetime.timezone.utc)
    amz_date = now.strftime("%Y%m%dT%H%M%SZ")
    date_stamp = now.strftime("%Y%m%d")
    payload_hash = hashlib.sha256(body).hexdigest() if body else EMPTY_SHA256

    canonical_headers = (
        f"host:{host}\n"
        f"x-amz-content-sha256:{payload_hash}\n"
        f"x-amz-date:{amz_date}\n"
    )
    signed_headers = "host;x-amz-content-sha256;x-amz-date"
    canonical_request = "\n".join([
        method, canonical_uri, query, canonical_headers, signed_headers, payload_hash,
    ])

    scope = f"{date_stamp}/{REGION}/{SERVICE}/aws4_request"
    string_to_sign = "\n".join([
        "AWS4-HMAC-SHA256", amz_date, scope,
        hashlib.sha256(canonical_request.encode()).hexdigest(),
    ])

    k = _sign(("AWS4" + SECRET_KEY).encode(), date_stamp)
    k = _sign(k, REGION)
    k = _sign(k, SERVICE)
    k = _sign(k, "aws4_request")
    signature = hmac.new(k, string_to_sign.encode(), hashlib.sha256).hexdigest()

    url = ENDPOINT + canonical_uri + (f"?{query}" if query else "")
    req = urllib.request.Request(url, data=body or None, method=method)
    req.add_header("x-amz-date", amz_date)
    req.add_header("x-amz-content-sha256", payload_hash)
    req.add_header(
        "Authorization",
        f"AWS4-HMAC-SHA256 Credential={ACCESS_KEY}/{scope}, "
        f"SignedHeaders={signed_headers}, Signature={signature}",
    )
    ctx = ssl.create_default_context(cafile=CA_FILE)
    with urllib.request.urlopen(req, context=ctx, timeout=60) as response:
        return response.read()


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    action = sys.argv[1]

    if action == "put":
        path, key = sys.argv[2], sys.argv[3]
        with open(path, "rb") as handle:
            _request("PUT", key, body=handle.read())
    elif action == "list":
        prefix = sys.argv[2] if len(sys.argv) > 2 else ""
        # S3 caps a listing at 1000 keys and sets IsTruncated when there are
        # more. Ignoring that does not error -- it silently returns a partial
        # answer, which is the worst possible behaviour for a check that asks
        # "is everything still there?". One backup of this cluster is already
        # more than 1000 objects.
        token = None
        while True:
            params = {"list-type": "2", "prefix": prefix}
            if token:
                params["continuation-token"] = token
            query = urllib.parse.urlencode(sorted(params.items()))
            xml = _request("GET", "", query=query).decode()
            # Keys here are generated by this lab and contain no XML-special
            # characters, which is what makes this safe without a parser.
            for chunk in xml.split("<Key>")[1:]:
                print(chunk.split("</Key>")[0])
            if "<IsTruncated>true</IsTruncated>" not in xml:
                break
            token = xml.split("<NextContinuationToken>")[1].split("<")[0]
    elif action == "cat":
        sys.stdout.buffer.write(_request("GET", sys.argv[2]))
    elif action == "delete":
        _request("DELETE", sys.argv[2])
    else:
        print(f"unknown action: {action}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # noqa: BLE001 - the caller only needs a clean failure
        print(f"lab3-s3: {exc}", file=sys.stderr)
        sys.exit(1)
